<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Heredamos de spring-boot-starter-parent: nos da versiones ya probadas y
         compatibles de TODAS las librerias de Spring (gestion de dependencias). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/> <!-- lo busca en el repositorio, no en una carpeta local -->
    </parent>

    <groupId>com.practica.apx</groupId>
    <artifactId>apx-banca</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>apx-banca</name>
    <description>Proyecto de practica para aprender la arquitectura APX de BBVA con Spring Boot</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web: nos da Spring MVC + un servidor Tomcat embebido para exponer APIs REST.
             Es la base de la "arquitectura online" de APX. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: endpoints de salud y metricas (/actuator/health, etc.).
             Base de la "observabilidad y trazabilidad" de APX (principio #5). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JDBC: nos da JdbcTemplate + gestion de DataSource/conexiones.
             Es la base de nuestro "JDBC Connector" (Paso 3.2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- H2: base de datos relacional en memoria. Aqui SIMULA el "mainframe"
             legacy de BBVA. scope=runtime: solo se necesita al ejecutar, no al
             compilar (nuestro codigo nunca importa clases de H2 directamente). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validation: Bean Validation (Jakarta) para validar requests con
             anotaciones (@NotNull, @Positive...) de forma declarativa. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Batch: arquitectura batch de APX (jobs chunk-oriented con
             reader/processor/writer, reinicio, metadatos de ejecucion). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Kafka: el Kafka Connector de APX (eventos pub/sub). -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Prometheus: expone las metricas de Micrometer en /actuator/prometheus
             (observabilidad estilo APX: monitorizacion estandarizada). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test: JUnit 5 + utilidades de test de Spring. Solo para el ciclo de pruebas. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin que empaqueta la app como un JAR ejecutable ("fat jar")
                 y permite arrancarla con: mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
